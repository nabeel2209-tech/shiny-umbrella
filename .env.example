# Copy to .env and fill in. Never commit .env.

# --- trading mode -----------------------------------------------------------
# Real orders are only sent when ALL of these hold:
#   LIVE_TRADING=true  AND  BROKER=dhan  AND  the startup prompt is confirmed.
LIVE_TRADING=false
BROKER=paper                # paper | dhan

# --- Dhan (DhanHQ v2) ---------------------------------------------------------
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# --- infrastructure -----------------------------------------------------------
REDIS_URL=redis://localhost:6379/0   # leave empty to use the in-memory bus
DB_URL=sqlite:///data/state.db        # any SQLAlchemy URL (Postgres-ready)
ARCHIVE_DIR=data/archive
HOLIDAYS_FILE=data/holidays/holidays.json

# --- paper trading ------------------------------------------------------------
PAPER_STARTING_CASH=1000000
PAPER_SLIPPAGE_BPS=2

# --- market hours (IST) -------------------------------------------------------
MCX_CLOSE=23:30

# --- feature flags ------------------------------------------------------------
FEATURE_MARKETPLACE=false

# --- misc ---------------------------------------------------------------------
LOG_LEVEL=INFO
