# Copy to .env and fill in. Never commit .env.

# --- trading mode -----------------------------------------------------------
# Real orders are only sent when ALL of these hold:
#   LIVE_TRADING=true  AND  BROKER=dhan  AND  the startup prompt is confirmed.
LIVE_TRADING=false
BROKER=paper                # paper | dhan

# --- Dhan (DhanHQ v2) ---------------------------------------------------------
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=            # 24h JWT from web.dhan.co -> My Profile -> Access DhanHQ APIs
DHAN_FEED_MODE=full           # ticker | quote | full (full = LTP + volume + 5-level depth)

# --- infrastructure -----------------------------------------------------------
REDIS_URL=redis://localhost:6379/0   # leave empty to use the in-memory bus
DB_URL=sqlite:///data/state.db        # any SQLAlchemy URL (Postgres-ready)
ARCHIVE_DIR=data/archive
MODELS_DIR=data/models               # model registry (versions + live pointers)
INSTRUMENTS_DIR=data/instruments     # daily cache of the Dhan scrip master + Nifty 100 list
CORPORATE_ACTIONS_FILE=data/corporate_actions.json
HOLIDAYS_FILE=data/holidays/holidays.json

# --- paper trading ------------------------------------------------------------
PAPER_STARTING_CASH=1000000
PAPER_SLIPPAGE_BPS=2

# --- market hours (IST) -------------------------------------------------------
MCX_CLOSE=23:30

# --- dashboard / API --------------------------------------------------------------
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=               # required to start the API (scripts/serve.py)
SESSION_SECRET=                   # 32+ random bytes, e.g. python -c "import secrets;print(secrets.token_hex(32))"
SESSION_TTL_HOURS=12
COOKIE_SECURE=false               # true when served over HTTPS
API_HOST=127.0.0.1                # keep on localhost unless it sits behind a TLS proxy
API_PORT=8000
STRATEGIES_DIR=data/strategies
STATE_DIR=data/state

# --- feature flags ------------------------------------------------------------
# Marketplace, Auto Trading and AI Strategies need SEBI algo-provider registration.
FEATURE_MARKETPLACE=false

# --- misc ---------------------------------------------------------------------
LOG_LEVEL=INFO
